#!/usr/bin/env bash
set -euo pipefail

# Validation only: never read real dotenv contents, regenerate snapshots, or stage
# files. Git supplies the commit index, including its temporary --only index.
if ! repo_root="$(git rev-parse --show-toplevel)"; then
	printf '%s\n' 'ERROR: Cannot find the repository root. Commit stopped.' >&2
	exit 1
fi
if ! cd "$repo_root"; then
	printf '%s\n' 'ERROR: Cannot enter the repository root. Commit stopped.' >&2
	exit 1
fi

validate_staged_names() {
	local staged_path filename
	while IFS= read -r -d '' staged_path; do
		filename="${staged_path##*/}"
		case "$filename" in
			# Only these exact template names are allowed, still subject to scanning.
			.env.example|.env.sample) ;;
			.env|.env.*)
				printf 'ERROR: Real dotenv filename cannot be committed: %q\n' "$staged_path" >&2
				printf '%s\n' 'Keep secret files outside Git. Review the staged files and use an empty .env.example or .env.sample template.' >&2
				return 1
				;;
		esac
	done
}

# NUL records preserve spaces and newlines. Disabling rename detection includes
# both the old and new paths. pipefail also blocks a failed Git name query.
if ! git diff --cached --name-only --no-renames --no-ext-diff --no-textconv -z -- | validate_staged_names; then
	printf '%s\n' 'ERROR: Staged filename validation failed. Commit stopped; review the index and any Git errors above.' >&2
	exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
	printf '%s\n' 'ERROR: gitleaks is required. Install it (brew install gitleaks), then retry the commit.' >&2
	exit 1
fi
if ! gitleaks protect --staged --redact --no-banner; then
	printf '%s\n' 'ERROR: gitleaks did not pass. Fix any findings or scanner errors, then retry the commit.' >&2
	exit 1
fi
