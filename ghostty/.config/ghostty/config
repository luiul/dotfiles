# Font settings
font-family = MesloLGS Nerd Font Mono
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Theme settings
theme = Monokai Pro Spectrum

# Cursor settings
cursor-style-blink = false
shell-integration-features = no-cursor
cursor-color = #B3B3B3
cursor-style = bar
adjust-cursor-thickness = 2

# Clipboard
clipboard-trim-trailing-spaces = true

# Keybindings
keybind = global:control+command+shift+option+r=toggle_quick_terminal

# Unbind default keybindings for herdr
keybind = cmd+n=unbind
keybind = cmd+shift+n=new_window

keybind = cmd+w=unbind
keybind = cmd+shift+w=close_window

keybind = cmd+t=unbind
keybind = cmd+shift+t=new_tab

# Padding
window-padding-x = 8

notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
# notify-on-command-finish-after = 30s
