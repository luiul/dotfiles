# Font settings
font-family = JetBrainsMono Nerd Font Mono
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Theme settings
theme = Monokai Pro Spectrum

# Cursor settings
cursor-style-blink = false
cursor-color = #B3B3B3
cursor-style = bar
adjust-cursor-thickness = 2

# Clipboard
clipboard-trim-trailing-spaces = true

# Keybindings
keybind = global:control+command+shift+option+r=toggle_quick_terminal
# Quick terminal: show on the screen the mouse is hovered over, not the one
# receiving keyboard input (Ghostty's default `main`, which follows the
# active window).
quick-terminal-screen = mouse
# Command center: hard-pin the focused tab's title (covers every split in it)
# and overrides all shell OSC title changes (zsh precmd, pi, canopy).
# Empty argument clears the override and restores automatic titles.
keybind = cmd+shift+c=set_tab_title:🎛 cc
keybind = cmd+shift+x=set_tab_title:
# Only consume cmd+c when Ghostty itself has a selection; otherwise pass the
# key through to the app (pi binds super+c to copy its fullscreen selection).
keybind = performable:cmd+c=copy_to_clipboard

# Title: disable Ghostty's automatic shell-integration title. The zsh hook in
# ~/.zsh_config/title.zsh sets it instead (repo root + branch, VS Code style).
shell-integration-features = no-cursor,no-title

# Padding
window-padding-x = 8

notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
# notify-on-command-finish-after = 30s
