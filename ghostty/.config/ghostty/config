# Font settings
font-family = JetBrainsMono Nerd Font Mono
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Theme settings
theme = Monokai Pro Spectrum

# Cursor settings
cursor-style-blink = false
shell-integration-features = no-cursor
cursor-color = #B3B3B3
cursor-style = bar
adjust-cursor-thickness = 2

# Clipboard
clipboard-trim-trailing-spaces = true

# Keybindings
keybind = global:control+command+shift+option+r=toggle_quick_terminal
# Cmd+I: ask pi about commands (sends ^G, bound to pi-ask-widget in zsh)
keybind = cmd+i=text:\x07

# Padding
window-padding-x = 8

notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
# notify-on-command-finish-after = 30s
