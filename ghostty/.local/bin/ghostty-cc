#!/bin/bash

# Karabiner calls `ghostty-cc mark` or `ghostty-cc` directly.
# A locked tab title survives shell title changes and remains visible in background tabs.
TITLE="🎛 cc"
MODE="${1:-focus}"
case "$MODE" in focus|mark) ;; *) exit 2 ;; esac

# Serialize shortcut presses so two callers cannot create or mark two command centers.
mkdir -p "$HOME/.cache" || exit 1
LOCK="$HOME/.cache/cc.lock"
for ((attempt = 0; attempt < 100; attempt++)); do
  /usr/bin/shlock -p "$$" -f "$LOCK" && break
  sleep 0.05
done
if ((attempt == 100)); then exit 1; fi
trap 'rm -f "$LOCK"' EXIT

if result=$(osascript - "$MODE" "$TITLE" "$HOME" <<'APPLESCRIPT'
-- Ghostty can prepend a bell indicator even when the tab title is locked.
on isCommandCenter(tabTitle, ccTitle)
	return tabTitle is ccTitle or tabTitle is ("🔔 " & ccTitle)
end isCommandCenter

on run argv
	set mode to item 1 of argv
	set ccTitle to item 2 of argv
	set homeDir to item 3 of argv
	tell application "Ghostty"
		if mode is "mark" then
			if not running or not frontmost then error "Ghostty is not focused."
			set targetWindowID to id of front window
			set targetTabID to id of selected tab of front window
			set targetTerminalID to id of focused terminal of selected tab of front window
			-- Mark first so a failed action cannot erase the previous designation.
			perform action ("set_tab_title:" & ccTitle) on terminal id targetTerminalID
			if not my isCommandCenter(name of tab id targetTabID of window id targetWindowID, ccTitle) then error "Could not mark the tab."
			set previousTabs to {}
			repeat with w in windows
				repeat with t in tabs of w
					if id of t is not targetTabID and my isCommandCenter(name of t, ccTitle) then
						set end of previousTabs to {id of w, id of t, id of focused terminal of t}
					end if
				end repeat
			end repeat
			-- Changing titles can reorder windows. Resolve each saved ID afresh.
			repeat with previousTab in previousTabs
				perform action "set_tab_title:" on terminal id (item 3 of previousTab)
				if my isCommandCenter(name of tab id (item 2 of previousTab) of window id (item 1 of previousTab), ccTitle) then error "Could not clear the previous tab."
			end repeat
			return "marked"
		end if

		set wasRunning to running
		if not wasRunning then
			activate
			repeat 40 times
				if (count of windows) > 0 then exit repeat
				delay 0.1
			end repeat
			if (count of windows) is 0 then error "Ghostty did not open a window."
		end if
		-- Window titles hide background tabs. Search all tabs, including restored ones.
		-- Allow title updates and restored tabs to settle before creating a window.
		repeat with attempt from 1 to 11
			repeat with w in windows
				repeat with t in tabs of w
					if my isCommandCenter(name of t, ccTitle) then
						-- Activation can reorder windows, invalidating positional references.
						set targetTerminalID to id of focused terminal of t
						activate
						focus terminal id targetTerminalID
						return "focused"
					end if
				end repeat
			end repeat
			if attempt < 11 then delay 0.1
		end repeat
		if wasRunning then
			set w to new window with configuration {initial working directory:homeDir}
		else
			-- Use the startup window instead of creating a second one.
			set w to front window
		end if
		set targetTab to selected tab of w
		perform action ("set_tab_title:" & ccTitle) on focused terminal of targetTab
		if not my isCommandCenter(name of targetTab, ccTitle) then error "Could not mark the new tab."
		set targetTerminalID to id of focused terminal of targetTab
		activate
		focus terminal id targetTerminalID
		return "opened"
	end tell
end run
APPLESCRIPT
); then
  printf '%s %s\n' "$(date '+%F %T')" "$result" >> "$HOME/.cache/cc.log"
  case "$result" in focused|opened|marked) exit 0 ;; esac
fi
osascript -e 'display notification "Could not mark or open the Ghostty command center." with title "Command Center"'
exit 1
