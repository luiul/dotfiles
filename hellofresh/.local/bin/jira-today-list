#!/usr/bin/env bash
# Produce the ticket list for jira-today's fzf picker: one row per ticket,
# header row first, columns BUCKET, KEY, TYPE, STATUS, SUMMARY.
#
# This is a script, not inline in the jira-today zsh function, because fzf's
# ctrl-r `reload` binding re-runs the producer in a non-interactive
# `$SHELL -c`, which never sources .zsh_config (it does inherit the exported
# PATH, so ~/.local/bin is visible). Same reason jira-worktree is a script.
#
# Tickets are my open GLOA issues, grouped into Sprint (active sprint), one
# bucket per future sprint (named after it, nearest first), and Backlog (no
# sprint assigned), so it is visually clear which bucket each ticket sits in,
# then by a fixed workflow order (not alphabetical), then by most recently
# updated within each group (not shown, to leave more room for the summary).
# Excludes Done items and Epics.
#
# The buckets come from ONE Jira search call (REST, curl + jq), not from
# jira-cli, because jira-cli cannot name future sprints: `jira issue list`
# has no sprint column (and --raw omits the field), and `jira sprint list`
# hardcodes state=active,closed in its API request (its -q filter is
# silently ignored; verified with --debug against v1.7.0), so future sprints
# never show up in it. The search API returns the sprint field
# (customfield_10007; the other "Sprint" field customfield_13226 is always
# empty here) as structured objects with id, name, and state per ticket, so
# bucketing needs no sprint discovery and can never miss a sprint.
# Bucket rule per ticket: an ACTIVE sprint wins ("Sprint"), else the
# lowest-id FUTURE sprint (ids grow chronologically, and the id doubles as
# the bucket's sort rank), else Backlog. Auth reuses JIRA_API_TOKEN from the
# environment (the same var jira-cli authenticates with) plus login/server
# parsed out of jira-cli's config.
#
# If the API path is unavailable (no token, no jq, curl/jq failure), the
# script falls back to two jira-cli queries (one combined
# `openSprints() OR futureSprints()` query under a single Sprint bucket, one
# `sprint is EMPTY` under Backlog), so a broken API path never hides
# tickets; future buckets just collapse into Sprint.
#
# A bucket with no tickets is omitted entirely: jira-cli prints a bare
# newline on stdout for an empty result, which the prefixing awk skips via
# its NF guard, and jira-cli's benign "No result found" stderr notice is
# filtered out so only real errors (e.g. API failures like a 405) reach the
# terminal.
#
# Workflow order: Open, Reopened, In Progress, Peer review, On Hold, then
# anything else.
#
# No `set -e`: the fallback path must survive individual query failures, and
# fzf's reload ignores the exit status and just takes stdout.
set -uo pipefail

base='project = GLOA AND assignee = currentUser() AND statusCategory != Done AND issuetype != Epic'
cols='key,type,status,updated,summary'

# Emit fully ranked rows: bucket_rank, status_rank, bucket, key, type,
# status, updated, summary (updated last-but-one so both paths share one
# sort). The API path ranks future buckets by sprint id; the fallback ranks
# Sprint 0 and Backlog 1.
ranked_rows() {
	local rows
	if [[ -n ${JIRA_API_TOKEN:-} ]] && command -v jq >/dev/null 2>&1; then
		local login server
		login=$(sed -n 's/^login: //p' ~/.config/.jira/.config.yml)
		server=$(sed -n 's/^server: //p' ~/.config/.jira/.config.yml)
		if [[ -n $login && -n $server ]] && rows=$(
			curl -sf --max-time 15 -u "$login:$JIRA_API_TOKEN" --get "$server/rest/api/3/search/jql" \
				--data-urlencode "jql=$base AND (sprint in openSprints() OR sprint in futureSprints() OR sprint is EMPTY)" \
				--data-urlencode 'fields=summary,status,issuetype,updated,customfield_10007' \
				--data-urlencode 'maxResults=500' |
				jq -r '
					# Drop a trailing parenthetical (sprint dates) from bucket names.
					def shortname: sub("\\s*\\([^)]*[0-9][^)]*\\)$"; "");
					def srank:
						if . == "Open" then 1 elif . == "Reopened" then 2
						elif . == "In Progress" then 3 elif . == "Peer review" then 4
						elif . == "On Hold" then 5 else 99 end;
					.issues[] |
					(.fields.customfield_10007 // []) as $sp |
					(($sp | map(select(.state == "active")) | .[0]) // null) as $act |
					(($sp | map(select(.state == "future")) | sort_by(.id) | .[0]) // null) as $fut |
					(if $act then [0, "Sprint"]
					 elif $fut then [$fut.id, ($fut.name | shortname)]
					 else [99999999, "Backlog"] end) as $b |
					# Pipes in the summary would break the |-delimited pipeline.
					[ $b[0], (.fields.status.name | srank), $b[1], .key, .fields.issuetype.name,
						.fields.status.name, (.fields.updated[0:19] | sub("T"; " ")),
						(.fields.summary | gsub("\\|"; "/")) ] | join("|")
				'
		); then
			# Success, possibly zero rows; awk drops the empty line either way.
			printf '%s\n' "$rows" | awk 'NF'
			return
		fi
	fi
	# Fallback: jira-cli, future buckets collapsed into one Sprint bucket.
	{
		jira issue list -q "$base AND (sprint in openSprints() OR sprint in futureSprints())" \
			--plain --no-headers --columns "$cols" --delimiter '|' \
			2> >(grep -v 'No result found for given query' >&2) |
			awk -F'|' -v OFS='|' 'NF { print "Sprint", $0 }'
		jira issue list -q "$base AND sprint is EMPTY" \
			--plain --no-headers --columns "$cols" --delimiter '|' \
			2> >(grep -v 'No result found for given query' >&2) |
			awk -F'|' -v OFS='|' 'NF { print "Backlog", $0 }'
	} | awk -F'|' -v OFS='|' '
		{
			bucket_rank = ($1 == "Sprint") ? 0 : 1
			status_rank = 99
			if ($4 == "Open") status_rank = 1
			else if ($4 == "Reopened") status_rank = 2
			else if ($4 == "In Progress") status_rank = 3
			else if ($4 == "Peer review") status_rank = 4
			else if ($4 == "On Hold") status_rank = 5
			print bucket_rank, status_rank, $0
		}
	'
}

ranked_rows |
	sort -t'|' -k1,1n -k2,2n -k7,7r |
	cut -d'|' -f3- |
	awk -F'|' -v OFS='|' '{ print $1, $2, $3, $4, $6 }' |
	{
		printf 'BUCKET|KEY|TYPE|STATUS|SUMMARY\n'
		cat
	} |
	column -t -s '|'
