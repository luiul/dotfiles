#!/usr/bin/env bash
# Compatibility shim. The implementation moved to slack-reader
# (~/projects/personal/slack-reader, https://github.com/luiul/slack-reader).
# The command name stays so existing docs and muscle memory keep working.
set -euo pipefail
exec "${SLACK_READER_DIR:-$HOME/projects/personal/slack-reader}/bin/slack-reader" "$@"
