#!/usr/bin/env bash
# Open only the managed headed Brave Beta profile under the shared CLI lock.
# The user completes SSO. The passive watcher verifies the rendered workspace.
# Leave the window open for reads, but session expiry and revocation remain possible.
set -euo pipefail
if [[ $# != 0 ]]; then
  printf '%s\n' 'Usage: slack-hf-session-login' >&2
  exit 2
fi
PROJECT_DIR="${SLACK_HF_READ_DIR:-$HOME/dotfiles/hellofresh/slack-hf-read}"
exec node "$PROJECT_DIR/src/main.ts" login
