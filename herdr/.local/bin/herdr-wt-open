#!/usr/bin/env -S uv run --script
"""Open an existing wt checkout in the calling Herdr session without moving focus."""
# ruff: noqa: S603

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

ARGUMENT_COUNT = 3


def main() -> int:
    """Register a linked checkout only when an explicit caller socket exists."""
    if os.environ.get("HERDR_ENV") != "1" or not os.environ.get("HERDR_SOCKET_PATH"):
        return 0
    if len(sys.argv) != ARGUMENT_COUNT:
        print("Usage: herdr-wt-open REPO_PATH WORKTREE_PATH", file=sys.stderr)
        return 2
    repo = Path(sys.argv[1]).resolve()
    checkout = Path(sys.argv[2]).resolve()
    if not repo.is_dir() or not checkout.is_dir() or repo == checkout:
        return 0
    binary = os.environ.get("HERDR_BIN_PATH", "herdr")
    try:
        result = subprocess.run(
            [binary, "worktree", "list", "--cwd", str(repo)],
            capture_output=True, text=True, timeout=8, check=True,
        )
        items = json.loads(result.stdout)["result"]["worktrees"]
        item = next((entry for entry in items if Path(entry["path"]).resolve() == checkout), None)
        if item is None or not item.get("is_linked_worktree") or item.get("open_workspace_id"):
            return 0
        # No label override: opening a reused workspace must not reset a custom name.
        subprocess.run(
            [binary, "worktree", "open", "--cwd", str(repo), "--path", str(checkout), "--no-focus"],
            capture_output=True, text=True, timeout=8, check=True,
        )
    except (OSError, subprocess.SubprocessError, ValueError, KeyError) as error:
        print(f"herdr-wt-open: sidebar registration failed, checkout is unchanged: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
