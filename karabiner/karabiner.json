{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "manipulators": [
                            {
                                "description": "Mark the focused Ghostty tab as the command center.",
                                "type": "basic",
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["command", "shift"] }
                                },
                                "to": [
                                    {
                                        "shell_command": "$HOME/.local/bin/ghostty-cc mark"
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"]
                                    }
                                ]
                            },
                            {
                                "description": "Focus or create the Ghostty command center with super+c.",
                                "type": "basic",
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
                                },
                                "to": [
                                    {
                                        "shell_command": "$HOME/.local/bin/ghostty-cc"
                                    }
                                ]
                            },
                            {
                                "description": "Open the focused Ghostty directory in VS Code.",
                                "type": "basic",
                                "from": {
                                    "key_code": "e",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [
                                    {
                                        "shell_command": "$HOME/.local/bin/ghostty-open-vscode"
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"]
                                    }
                                ]
                            },
                            {
                                "description": "Change caps_lock to command+control+option+shift.",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_control", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Copy in Orca terminals: pass Cmd+C through and add Cmd+Shift+C for Kitty-active TUIs (pi copy).",
                                "type": "basic",
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "c",
                                        "modifiers": ["command"]
                                    },
                                    {
                                        "key_code": "c",
                                        "modifiers": ["command", "shift"]
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": ["^com\\.stablyai\\.orca$"]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "iso" }
        }
    ]
}