#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Back up Apple Mail and repair only the known invalid IMAP copy queue crash."""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import hashlib
import json
import os
import plistlib
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from urllib.parse import urlsplit

RULE_FILES = ("RulesActiveState.plist", "SyncedRules.plist", "UnsyncedRules.plist")
QUEUE_COLUMNS = {
    "local_message_actions": (
        "ROWID",
        "mailbox",
        "source_mailbox",
        "destination_mailbox",
        "action_type",
        "user_initiated",
    ),
    "action_messages": ("ROWID", "action", "action_phase", "message", "remote_id", "destination_message"),
    "action_flags": ("ROWID", "action", "flag_type", "flag_value"),
    "action_labels": ("ROWID", "action", "do_add", "label"),
}
MESSAGE_COLUMNS = "ROWID message_id global_message_id remote_id document_id sender subject_prefix subject summary date_sent date_received mailbox remote_mailbox flags read flagged deleted size conversation_id date_last_viewed list_id_hash unsubscribe_type searchable_message brand_indicator display_date flag_color is_urgent color type fuzzy_ancestor automated_conversation root_status".split()
MAILBOX_COLUMNS = "ROWID url total_count unread_count deleted_count unseen_count unread_count_adjusted_for_duplicates change_identifier source alleged_change_identifier".split()


class RepairError(Exception):
    """An unsafe or unsupported state. Leave the database unchanged."""


def require_mail_closed() -> None:
    result = subprocess.run(["/usr/bin/pgrep", "-x", "Mail"], capture_output=True, text=True, timeout=5)
    if result.returncode == 0:
        raise RepairError("Quit Mail first. This command never quits or force-quits Mail.")
    if result.returncode != 1:
        raise RepairError("Could not check whether Mail is running.")


def load_plist(path: Path):
    with path.open("rb") as source:
        return plistlib.load(source)


def mail_paths(home: Path) -> tuple[Path, Path]:
    root = home / "Library/Mail"
    info = load_plist(root / "PersistenceInfo.plist")
    version = info.get("LastUsedVersionDirectoryName")
    if version != "V10":
        raise RepairError(f"Unsupported Mail storage version: {version!r}. No repair attempted.")
    data = root / version / "MailData"
    db = data / "Envelope Index"
    if not db.is_file():
        raise RepairError("Mail's Envelope Index was not found.")
    return data, db


def connect_readonly(path: Path) -> sqlite3.Connection:
    connection = sqlite3.connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=5)
    connection.row_factory = sqlite3.Row
    return connection


def quote(name: str) -> str:
    return '"' + name.replace('"', '""') + '"'


def tables(connection: sqlite3.Connection) -> list[str]:
    return [r[0] for r in connection.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")]


def check_database(connection: sqlite3.Connection) -> None:
    if [r[0] for r in connection.execute("PRAGMA quick_check")] != ["ok"]:
        raise RepairError("Database integrity check failed. No repair attempted.")
    layouts = {**QUEUE_COLUMNS, "messages": MESSAGE_COLUMNS, "mailboxes": MAILBOX_COLUMNS}
    for name, expected in layouts.items():
        columns = list(connection.execute(f"PRAGMA table_info({quote(name)})"))
        if [r[1] for r in columns] != list(expected) or columns[0][2:6] != ("INTEGER", 0, None, 1):
            raise RepairError(f"Unsupported database layout: {name}. No repair attempted.")
        if name in QUEUE_COLUMNS and any(r[2] != "INTEGER" for r in columns):
            raise RepairError(f"Unsupported queue column types: {name}.")
    # Only queue tables are changed. Mail's normal message and label triggers cannot fire.
    trigger_tables = {r[0] for r in connection.execute("SELECT tbl_name FROM sqlite_master WHERE type='trigger'")}
    if trigger_tables.intersection(QUEUE_COLUMNS):
        raise RepairError("Triggers on queue tables are not supported. No repair attempted.")
    for name in tables(connection):
        for key in connection.execute(f"PRAGMA foreign_key_list({quote(name)})"):
            if key[2] in QUEUE_COLUMNS and not (
                name in ("action_messages", "action_flags", "action_labels") and key[2] == "local_message_actions"
            ):
                raise RepairError(f"Unsupported queue dependency: {name}. No repair attempted.")
    foreign_keys = {
        "local_message_actions": {
            ("mailbox", "mailboxes", "ROWID", "CASCADE"),
            ("source_mailbox", "mailboxes", "ROWID", "CASCADE"),
            ("destination_mailbox", "mailboxes", "ROWID", "CASCADE"),
        },
        "action_messages": {
            ("action", "local_message_actions", "ROWID", "CASCADE"),
            ("message", "messages", "ROWID", "SET NULL"),
            ("destination_message", "messages", "ROWID", "CASCADE"),
        },
        "action_flags": {("action", "local_message_actions", "ROWID", "CASCADE")},
        "action_labels": {
            ("action", "local_message_actions", "ROWID", "CASCADE"),
            ("label", "mailboxes", "ROWID", "CASCADE"),
        },
    }
    for name, expected in foreign_keys.items():
        actual = {(r[3], r[2], r[4], r[6]) for r in connection.execute(f"PRAGMA foreign_key_list({quote(name)})")}
        if actual != expected:
            raise RepairError(f"Unsupported foreign keys: {name}.")


def find_candidates(connection: sqlite3.Connection) -> list[dict]:
    result = []
    rows = connection.execute("""
        SELECT a.ROWID action_id, am.ROWID item_id, am.remote_id uid,
               am.message, am.destination_message, a.mailbox, a.source_mailbox,
               a.destination_mailbox, src.url source, dst.url destination,
               m.ROWID retained_message, m.remote_id retained_uid, m.mailbox retained_mailbox
        FROM local_message_actions a JOIN action_messages am ON am.action=a.ROWID
        LEFT JOIN mailboxes src ON src.ROWID=a.source_mailbox
        LEFT JOIN mailboxes dst ON dst.ROWID=a.destination_mailbox
        LEFT JOIN messages m ON m.ROWID=am.destination_message
        WHERE a.action_type=6 AND am.action_phase=3
          AND (am.remote_id IS NULL OR am.remote_id<=0)
        ORDER BY a.ROWID,am.ROWID
    """)
    for row in rows:
        candidate = dict(row)
        action = candidate["action_id"]
        src = urlsplit(candidate["source"] or "")
        dst = urlsplit(candidate["destination"] or "")
        safe = (
            src.scheme == dst.scheme == "imap"
            and src.netloc
            and src.netloc == dst.netloc
            and candidate["mailbox"] == candidate["source_mailbox"]
            and candidate["message"] is None
            and candidate["retained_message"] is not None
            and candidate["retained_uid"] is None
            and candidate["retained_mailbox"] == candidate["destination_mailbox"]
        )
        counts = [
            connection.execute(f"SELECT count(*) FROM {quote(t)} WHERE action=?", (action,)).fetchone()[0]
            for t in ("action_messages", "action_flags", "action_labels")
        ]
        if not safe or counts != [1, 0, 0]:
            raise RepairError(
                f"Action {action} has an invalid UID but does not match the safe repair pattern. No repair attempted."
            )
        result.append(candidate)
    return result


def crash_evidence(home: Path) -> bool:
    reports = home / "Library/Logs/DiagnosticReports"
    cutoff = dt.datetime.now().timestamp() - 7 * 86400
    for report in reports.glob("Mail-*.ips"):
        if report.stat().st_mtime < cutoff:
            continue
        try:
            _, body = report.read_text().split("\n", 1)
            payload = json.loads(body)
            thread = payload["threads"][payload["faultingThread"]]
            symbols = [frame.get("symbol", "") for frame in thread["frames"]]
            if any("IMAPUIDCommand initWithMailboxName:UIDs:" in s for s in symbols) and any(
                "ECTransferActionIMAPReplayer" in s for s in symbols
            ):
                return True
        except (ValueError, KeyError, IndexError, TypeError):
            continue
    return False


def private_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise RepairError(f"Backup directory must be owned by you, private (700), and not a symlink: {path}")


@contextlib.contextmanager
def repair_lock(base: Path):
    private_directory(base)
    fd = os.open(base / ".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
            raise RepairError("The repair lock must be a private file owned by you.")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RepairError("Another mail-repair command is running.") from exc
        yield
    finally:
        os.close(fd)


def create_backup(connection: sqlite3.Connection, data: Path, base: Path, candidates: list[dict]) -> Path:
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S-")
    backup = Path(tempfile.mkdtemp(prefix=stamp, dir=base))
    print(f"Backup: {backup}", flush=True)
    dest = backup / "Envelope Index"
    dest.touch(mode=0o600)
    with contextlib.closing(sqlite3.connect(dest)) as saved:
        deadline = time.monotonic() + 30

        def check_backup_time(_status, _remaining, _total):
            if time.monotonic() > deadline:
                raise RepairError("Backup timed out. Mail data was not changed.")

        connection.backup(saved, pages=256, progress=check_backup_time)
        # .backup includes committed WAL data, but the copy may inherit WAL mode.
        saved.execute("PRAGMA journal_mode=DELETE")
        saved.row_factory = sqlite3.Row
        check_database(saved)
    for name in RULE_FILES:
        source = data / name
        if source.exists():
            (backup / name).write_bytes(source.read_bytes())
    persistence = data.parent.parent / "PersistenceInfo.plist"
    (backup / persistence.name).write_bytes(persistence.read_bytes())
    hashes = {}
    for file in backup.iterdir():
        with file.open("rb") as stream:
            hashes[file.name] = hashlib.file_digest(stream, "sha256").hexdigest()
    manifest = {
        "format": 1,
        "source": str(data / "Envelope Index"),
        "created": dt.datetime.now(dt.timezone.utc).isoformat(),
        "candidates": candidates,
        "counts": {
            name: connection.execute(f"SELECT count(*) FROM {quote(name)}").fetchone()[0] for name in tables(connection)
        },
        "files": hashes,
    }
    (backup / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    for file in backup.iterdir():
        file.chmod(0o600)
        with file.open("rb") as stream:
            os.fsync(stream.fileno())
    directory = os.open(backup, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    return backup


def compare_backup(connection: sqlite3.Connection, expected: dict[str, int]) -> None:
    current_tables = tables(connection)
    saved_tables = [
        r[0] for r in connection.execute("SELECT name FROM baseline.sqlite_master WHERE type='table' ORDER BY name")
    ]
    if current_tables != saved_tables:
        raise RepairError("Database tables changed. The repair was rolled back.")
    without_rowid = {r[1] for r in connection.execute("PRAGMA main.table_list") if r[4]}
    for name in current_tables:
        table = quote(name)
        columns = {r[1].lower() for r in connection.execute(f"PRAGMA table_info({table})")}
        selection = "*"
        if name not in without_rowid:
            # Include implicit identities, not just distinct values. .backup preserves them.
            identity = next((key for key in ("rowid", "_rowid_", "oid") if key not in columns), None)
            if identity is None:
                raise RepairError(f"Ambiguous row identity in {name}. No repair attempted.")
            selection = f"{identity}, *"
        current_count = connection.execute(f"SELECT count(*) FROM main.{table}").fetchone()[0]
        saved_count = connection.execute(f"SELECT count(*) FROM baseline.{table}").fetchone()[0]
        added = connection.execute(
            f"SELECT count(*) FROM (SELECT {selection} FROM main.{table} EXCEPT SELECT {selection} FROM baseline.{table})"
        ).fetchone()[0]
        removed = connection.execute(
            f"SELECT count(*) FROM (SELECT {selection} FROM baseline.{table} EXCEPT SELECT {selection} FROM main.{table})"
        ).fetchone()[0]
        if added or removed != expected.get(name, 0) or saved_count - current_count != expected.get(name, 0):
            raise RepairError(f"Unexpected changes in {name}. The repair was rolled back.")
    # Catch schema and trigger changes as well as row changes.
    for left, right in (("main", "baseline"), ("baseline", "main")):
        if connection.execute(
            f"SELECT count(*) FROM (SELECT * FROM {left}.sqlite_master EXCEPT SELECT * FROM {right}.sqlite_master)"
        ).fetchone()[0]:
            raise RepairError("Database schema changed. The repair was rolled back.")


def apply_repair(db: Path, backup: Path, candidates: list[dict], mail_check=require_mail_closed) -> None:
    with contextlib.closing(sqlite3.connect(db.resolve().as_uri() + "?mode=rw", uri=True, timeout=5)) as connection:
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA foreign_keys=ON")
        connection.execute(
            "ATTACH DATABASE ? AS baseline", ((backup / "Envelope Index").resolve().as_uri() + "?mode=ro",)
        )
        try:
            connection.execute("BEGIN IMMEDIATE")
            mail_check()
            check_database(connection)
            compare_backup(connection, {})
            if find_candidates(connection) != candidates:
                raise RepairError("The queue changed. No repair attempted.")
            for candidate in candidates:
                item = connection.execute(
                    "DELETE FROM action_messages WHERE ROWID=? AND action=?",
                    (candidate["item_id"], candidate["action_id"]),
                )
                action = connection.execute(
                    "DELETE FROM local_message_actions WHERE ROWID=?", (candidate["action_id"],)
                )
                if item.rowcount != 1 or action.rowcount != 1:
                    raise RepairError("The target operation changed. The repair was rolled back.")
            compare_backup(connection, {"action_messages": len(candidates), "local_message_actions": len(candidates)})
            check_database(connection)
            mail_check()
            connection.commit()
        except BaseException:
            connection.rollback()
            raise


def main(
    argv: list[str] | None = None, *, home: Path | None = None, mail_check=require_mail_closed, confirm=None
) -> int:
    parser = argparse.ArgumentParser(prog="mail-repair", description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="inspect only, do not create a backup or repair")
    mode.add_argument("--backup-only", action="store_true", help="create a verified backup without changing Mail")
    args = parser.parse_args(argv)
    backup = None
    try:
        mail_check()
        home = home or Path.home()
        data, db = mail_paths(home)
        print("SQLite may create WAL coordination files during inspection. Message data and rules stay unchanged.")
        with contextlib.closing(connect_readonly(db)) as connection:
            check_database(connection)
            candidates = [] if args.backup_only else find_candidates(connection)
            print(f"Found {len(candidates)} repairable invalid IMAP operation(s).")
            for candidate in candidates:
                print(
                    f"  Action {candidate['action_id']}, item {candidate['item_id']}, UID {candidate['uid']}, retained message {candidate['retained_message']}"
                )
            if args.dry_run:
                print("Read-only check. No backup or repair made.")
                return 0
            if not args.backup_only and not candidates:
                print("No repair needed for this crash pattern. No changes or backup made.")
                return 0
            if not args.backup_only:
                if not crash_evidence(home):
                    raise RepairError(
                        "No matching Mail crash report in the last seven days. Use --dry-run or seek a targeted diagnosis."
                    )
                print("This removes only the listed queue operations, not messages or rules.")
                print("Their pending moves or copies may not finish. Other operations stay queued.")
                if confirm is None:
                    if not sys.stdin.isatty():
                        raise RepairError("Repair needs confirmation in a terminal. Use --dry-run for inspection.")
                    answer = input("Back up and repair these operations? Type 'repair' to continue: ")
                else:
                    answer = confirm()
                if answer.strip() != "repair":
                    print("Cancelled. No changes or backup made.")
                    return 0
            base = home / "Library/Application Support/Mail Repair Backups"
            with repair_lock(base):
                mail_check()
                # Reopen after confirmation so a stale preview cannot authorize new targets.
                with contextlib.closing(connect_readonly(db)) as fresh:
                    fresh.execute("BEGIN")
                    check_database(fresh)
                    if not args.backup_only and find_candidates(fresh) != candidates:
                        raise RepairError("The queue changed after preview. Run the command again.")
                    backup = create_backup(fresh, data, base, candidates)
                mail_check()
                if not args.backup_only:
                    apply_repair(db, backup, candidates, mail_check)
        print(
            "Backup verified. Mail data was not changed."
            if args.backup_only
            else "Repair complete. Message records and rules are unchanged."
        )
        if not args.backup_only:
            print("Open Mail yourself and check syncing. If asked, choose Don't Reopen for a fresh window.")
        print("Keep the backup. Do not restore it over newer mail changes without checking them first.")
        return 0
    except PermissionError:
        print(
            "mail-repair: Access blocked. Grant Full Disk Access to your terminal app or Herdr Core, then retry.",
            file=sys.stderr,
        )
    except (
        RepairError,
        OSError,
        sqlite3.Error,
        plistlib.InvalidFileException,
        ValueError,
        EOFError,
        subprocess.SubprocessError,
    ) as exc:
        print(f"mail-repair: {exc}", file=sys.stderr)
    except KeyboardInterrupt:
        print("mail-repair: Cancelled.", file=sys.stderr)
    if backup:
        print(f"Backup preserved: {backup}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
