#!/bin/zsh -f
# Default to a dry run. The Node engine validates every argument before acting.
# Fixed paths also work with launchd's minimal PATH.
for runtime in /opt/homebrew/bin/node /usr/local/bin/node; do
  if [[ -x $runtime ]]; then
    exec "$runtime" "${0:A:h}/reap-strays.mjs" "$@"
  fi
done
print -u2 -- 'reap-strays: Node not found in a trusted install location.'
exit 1
