{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10
  },
  "mcpServers": {
    "kb": {
      "type": "http",
      "url": "https://genai-lab-api.eu.foundations.shared.int.hellofresh.io/mcp/v2",
      "lifecycle": "lazy",
      "directTools": true
    },
    "excalidraw": {
      "type": "http",
      "url": "https://mcp.excalidraw.com",
      "lifecycle": "lazy",
      "directTools": false
    },
    "drawio": {
      "type": "http",
      "url": "https://mcp.draw.io/mcp",
      "lifecycle": "lazy",
      "directTools": false
    },
    "slack": {
      "command": "slack-mcp-server-hf",
      "args": [
        "--transport",
        "stdio",
        "-no-cache",
        "-enabled-tools",
        "conversations_history,conversations_replies,conversations_search_messages,channels_list"
      ],
      "lifecycle": "lazy",
      "directTools": true
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--executable-path",
        "/Applications/Brave Browser Beta.app/Contents/MacOS/Brave Browser Beta",
        "--user-data-dir",
        "/Users/luis.aceituno/.pi/agent/data/playwright-brave-beta"
      ],
      "lifecycle": "lazy",
      "directTools": true
    }
  }
}