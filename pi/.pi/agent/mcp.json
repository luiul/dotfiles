{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10
  },
  "mcpServers": {
    "kb": {
      "type": "http",
      "url": "https://genai-lab-api.eu.foundations.shared.int.hellofresh.io/mcp/v2",
      "lifecycle": "lazy",
      "directTools": true
    },
    "excalidraw": {
      "type": "http",
      "url": "https://mcp.excalidraw.com",
      "lifecycle": "lazy",
      "directTools": false
    },
    "drawio": {
      "type": "http",
      "url": "https://mcp.draw.io/mcp",
      "lifecycle": "lazy",
      "directTools": false
    },
    "context-mode": {
      "command": "context-mode",
      "directTools": true
    },
    "slack": {
      "command": "slack-mcp-server-hf",
      "args": ["--transport", "stdio", "-no-cache", "-enabled-tools", "conversations_history,conversations_replies,conversations_search_messages,channels_list"],
      "lifecycle": "lazy",
      "directTools": true
    }
  }
}
