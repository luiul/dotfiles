# Files in this package that stow must NOT symlink into $HOME.
# settings.json and mcp-adapter.json are tracked snapshots, not stowed: pi
# rewrites both at runtime (changelog version on startup, MCP server installs),
# which would clobber a symlink. The live files are the source of truth.
# Refresh the snapshots with:
#   cp ~/.pi/agent/settings.json pi/.pi/agent/settings.json
#   cp ~/.pi/agent/mcp-adapter.json pi/.pi/agent/mcp-adapter.json
# npm/ holds a snapshot of the extensions install dir's package.json (npm
# audit overrides); the live dir has node_modules and a lockfile, never stow it.
npm
settings.json
mcp-adapter.json
\.stow-local-ignore
