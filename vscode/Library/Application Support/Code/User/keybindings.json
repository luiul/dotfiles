// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+enter",
        "command": "-jupyter.runcurrentcell",
        "when": "editorTextFocus && isWorkspaceTrusted && jupyter.hascodecells && !editorHasSelection && !jupyter.havenativecells && !notebookEditorFocused"
    },
    {
        "key": "ctrl+enter",
        "command": "-jupyter.runByLineStop",
        "when": "notebookCellResource in 'jupyter.notebookeditor.runByLineCells'"
    },
    {
        "key": "cmd+d",
        "command": "markdown.extension.toc.addSecNumbers"
    },
    {
        "key": "f2",
        "command": "renameFile",
        "when": "explorerViewletVisible && filesExplorerFocus && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    // Free up Alt+Cmd+T from its default (Close Other Editors)
    {
        "key": "alt+cmd+t",
        "command": "-workbench.action.closeOtherEditors"
    },
    // Terminal shortcuts: T toggle, S split, W close, R maximize panel
    {
        "key": "alt+cmd+t",
        "command": "workbench.action.terminal.toggleTerminal"
    },
    {
        "key": "alt+cmd+d",
        "command": "workbench.action.terminal.split",
        "when": "terminalFocus"
    },
    {
        "key": "alt+cmd+w",
        "command": "workbench.action.terminal.kill",
        "when": "terminalFocus"
    },
    {
        "key": "alt+cmd+r",
        "command": "workbench.action.toggleMaximizedPanel"
    },
    // WT Hop: jump to any repo/worktree, land in its terminal (pi session)
    {
        "key": "alt+cmd+h",
        "command": "wtHop.switch"
    },
    // Send Shift+Enter as CSI-u so TUIs (pi) can tell it from plain Enter.
    // Needed because terminal.integrated.enableKittyKeyboardProtocol stays off (Cmd+M fix).
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u001b[13;2u" },
        "when": "terminalFocus"
    },
    // Send Cmd+C as Ctrl+X to the terminal when nothing is selected, so pi's
    // fullscreen copy key (app.message.copy on ctrl+x, super+c) fires inside the
    // TUI. When text IS selected the default copySelection binding still wins, so
    // normal copy is unchanged. Kitty protocol stays off, so super+c never reaches
    // pi here; sending ctrl+x directly sidesteps that.
    {
        "key": "cmd+c",
        "command": "workbench.action.terminal.sendSequence",
        "args": { "text": "\u0018" },
        "when": "terminalFocus && !terminalTextSelected"
    },
    // Markdown All in One — Remove default keybindings that conflict with macOS shortcuts
    {
        "key": "cmd+b",
        "command": "-markdown.extension.editing.toggleBold"
    },
    {
        "key": "cmd+m",
        "command": "-markdown.extension.editing.toggleMath"
    },
    // Copy filename / relative path / absolute path
    // (default Explorer bindings for copyRelativeFilePath disabled below; both
    // are remapped to the F family, scoped to editorFocus like the rest of the group)
    {
        "key": "shift+alt+cmd+c",
        "command": "-copyRelativeFilePath",
        "when": "!editorFocus"
    },
    {
        "key": "cmd+k shift+alt+cmd+c",
        "command": "-copyRelativeFilePath",
        "when": "editorFocus"
    },
    {
        "key": "alt+cmd+f",
        "command": "copyRelativeFilePath",
        "when": "editorFocus"
    },
    {
        "key": "shift+alt+cmd+f",
        "command": "copyFilePath",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+alt+cmd+f",
        "command": "copy-file-name.copyFileName",
        "when": "editorFocus"
    },
    // Disable external terminal (keeps accidentally opening)
    {
        "key": "shift+cmd+c",
        "command": "-workbench.action.terminal.openNativeConsole",
        "when": "!terminalFocus"
    }
]
