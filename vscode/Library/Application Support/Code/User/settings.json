{
    // === Workbench Settings ===
    "workbench.settings.useSplitJSON": true,
    "workbench.startupEditor": "none",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.settings.editor": "json",
    "workbench.tree.renderIndentGuides": "always",
    // "workbench.tree.indent": 14,
    "workbench.list.openMode": "doubleClick",
    "workbench.fontAliasing": "antialiased",
    // UI font (file explorer, sidebar, tabs) via Custom UI Style: same as Zed
    "custom-ui-style.font.sansSerif": "'JetBrainsMono Nerd Font Mono', -apple-system, sans-serif",
    "custom-ui-style.stylesheet": {
        // ".monaco-workbench": "font-weight: 200;"
        // Smaller UI font. VS Code sets explicit px sizes on many parts, so each
        // must be overridden individually (a bare .monaco-workbench rule loses).
        ".monaco-workbench": "font-size: 11px;",
        // Sidebar, panel and editor part contents (file explorer, search, SCM, ...)
        ".monaco-workbench .part > .content": "font-size: 11px !important;",
        // Editor tab labels
        ".monaco-workbench .part.editor > .content .editor-group-container > .title .tabs-container > .tab .tab-label a": "font-size: 11px !important;",
        // Status bar
        ".monaco-workbench .part.statusbar": "font-size: 11px !important;",
        // Section headers (EXPLORER, OUTLINE, TERMINAL, ...)
        ".monaco-workbench .part > .title > .title-label h2, .monaco-pane-view .pane > .pane-header h3.title": "font-size: 11px !important;",
        // Window title in title bar
        ".monaco-workbench .part.titlebar > .titlebar-container > .titlebar-center > .window-title": "font-size: 11px !important;",
        // Slim the panel header row (the TERMINAL / PROBLEMS / OUTPUT tabs). ~35px by
        // default; no native setting exists. If a VS Code update misaligns the icons,
        // delete these rules.
        ".monaco-workbench .part.panel > .title": "height: 24px !important; min-height: 24px !important;",
        ".monaco-workbench .part.panel > .title > .composite-bar-container, .monaco-workbench .part.panel > .title > .panel-switcher-container": "height: 24px !important; min-height: 24px !important;",
        ".monaco-workbench .part.panel > .title .monaco-action-bar, .monaco-workbench .part.panel > .title .monaco-action-bar .action-item": "height: 24px !important;",
        ".monaco-workbench .part.panel > .title .monaco-action-bar .action-label": "font-size: 11px !important; line-height: 24px !important; padding-top: 0 !important; padding-bottom: 0 !important;"
    },
    "workbench.colorCustomizations": {
        "tab.activeBorderTop": "#ff00ee",
        "notebook.focusedCellBackground": "#0099ff30",
        "editor.findMatchBackground": "#8ffa876b",
        "editor.findMatchHighlightBackground": "#ff7dbe75",
        "tree.indentGuidesStroke": "#51bdd8",
        "tree.inactiveIndentGuidesStroke": "#232a35",
        "editor.lineHighlightBackground": "#008cff28",
        "editor.lineHighlightBorder": "#9fced11f",
    },
    "workbench.tree.enableStickyScroll": true,
    "workbench.sideBar.location": "right",
    "workbench.editor.alwaysShowEditorActions": true,
    // Cap open editors: the least-recently-used one closes past 10 (memory + clutter).
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    // Kill UI animations (the real equivalent of the bogus "performanceMode" setting).
    "workbench.reduceMotion": "on",
    // === Editor Settings ===
    "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', Menlo, DejaVu Sans Mono, Source Code Pro, Inconsolata, Monaco, Courier New, monospace",
    "editor.fontSize": 12,
    // "editor.fontWeight": 200,
    "editor.fontLigatures": false,
    "editor.wordWrap": "on",
    "editor.smoothScrolling": false,
    "editor.cursorBlinking": "solid",
    "editor.guides.bracketPairs": true,
    // Native indent guides (replaces the uninstalled indent-rainbow extension).
    "editor.guides.indentation": true,
    "editor.bracketPairColorization.enabled": false,
    "editor.inlineSuggest.enabled": true,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.minimap.enabled": false,
    "editor.folding": true,
    "editor.showFoldingControls": "mouseover",
    "editor.glyphMargin": true,
    "editor.padding.top": 0,
    "editor.padding.bottom": 0,
    "editor.rulers": [
        120
    ],
    "editor.stickyScroll.enabled": true,
    "editor.tokenColorCustomizations": {
        "comments": "#aaaaaa",
        "textMateRules": [
            {
                "scope": "heading.1.markdown entity.name.section.markdown, heading.1.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#e86f4f"
                }
            },
            {
                "scope": "heading.2.markdown entity.name.section.markdown, heading.2.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#f4a361"
                }
            },
            {
                "scope": "heading.3.markdown entity.name.section.markdown, heading.3.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#eac56a"
                }
            },
            {
                "scope": "heading.4.markdown entity.name.section.markdown, heading.4.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#269f91"
                }
            },
            {
                "scope": "heading.5.markdown entity.name.section.markdown, heading.5.markdown punctuation.definition.heading.markdown",
                "settings": {
                    "foreground": "#5d99b0"
                }
            }
        ]
    },
    "editor.lineNumbers": "on",
    // TRIAL: off for perf. CodeLens providers re-run on every document change.
    // Revert if you miss reference/test lenses.
    "editor.codeLens": false,
    // === Breadcrumbs (extra vertical space) ===
    // "breadcrumbs.enabled": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    // === Editor hygiene ===
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.renderWhitespace": "boundary",
    "editor.tabSize": 4,
    // === Format on Save (global & per-language)
    "editor.formatOnSave": true,
    // === Terminal Settings ===
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', Menlo, DejaVu Sans Mono, Source Code Pro, Inconsolata, Monaco, Courier New, monospace",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.persistentSessionScrollback": 100,
    "terminal.integrated.lineHeight": 1.3,
    // Compact panel: only show the terminal tab list when terminals are split into
    // groups. A single group (even with several terminals) gets a dropdown instead.
    "terminal.integrated.tabs.hideCondition": "singleGroup",
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorStyleInactive": "none",
    "terminal.integrated.cursorWidth": 2,
    // === Diff Editor Settings ===
    "diffEditor.wordWrap": "inherit",
    "diffEditor.experimental.showMoves": true,
    // === Explorer Settings ===
    "explorer.sortOrder": "foldersNestsFiles",
    "explorer.confirmDragAndDrop": false,
    "explorer.compactFolders": false,
    // === Notebook Settings ===
    "notebook.insertToolbarLocation": "notebookToolbar",
    "notebook.output.textLineLimit": 40,
    "notebook.output.lineHeight": 18,
    "notebook.stickyScroll.enabled": true,
    "notebook.diff.ignoreMetadata": true,
    "notebook.cellExecutionTimeVerbosity": "verbose",
    // === Git Settings ===
    "git.autoStash": true,
    "git.autoRepositoryDetection": "openEditors",
    "git.openRepositoryInParentFolders": "always",
    "git.autofetch": false,
    // TRIAL: no repo rescan on every file event. Cheaper SCM, but the git status
    // badge can go stale until manual refresh. Revert if annoying.
    "git.autorefresh": false,
    // Cosmetic only: the window registry (dashkit's vscode-window-registry extension) is
    // what tools match windows on. ${rootPath} tilde-collapses ("~/dotfiles — main"), so the
    // Window menu shows paths for humans. Needs a Code restart: the symlinked settings file
    // is not watched (microsoft/vscode#24739).
    "window.title": "${rootPath}${separator}${activeRepositoryBranchName}",
    // === GitHub Settings ===
    "githubPullRequests.remotes": [
        "origin",
        "upstream"
    ],
    "githubPullRequests.pushBranch": "always",
    "githubPullRequests.pullBranch": "never",
    "githubPullRequests.fileListLayout": "tree",
    "githubIssues.queries": [
        {
            "label": "My Issues",
            "query": "is:open assignee:${user} repo:${owner}/${repository}",
            "groupBy": [
                "milestone"
            ]
        },
        {
            "label": "Created Issues",
            "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
        },
        {
            "label": "Recent Issues",
            "query": "state:open repo:${owner}/${repository} sort:updated-desc"
        }
    ],
    // === Language-Specific Settings ===
    "[markdown]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "yzhang.markdown-all-in-one",
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.formatOnSave": false
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    // === Python formatter  ===
    "[python]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    //
    // Ruff
    //
    "ruff.path": [
        "${env:HOME}/.local/bin/ruff"
    ],
    "ruff.importStrategy": "fromEnvironment",
    "ruff.configuration": "${env:HOME}/.config/ruff/ruff.toml",
    // Repos that declare their own ruff config (e.g. pyproject [tool.ruff]) win over
    // the personal global config above; the global one only applies to config-less repos.
    "ruff.configurationPreference": "filesystemFirst",
    //
    // Ty
    //
    "ty.path": [
        "${env:HOME}/.local/bin/ty"
    ],
    "ty.importStrategy": "fromEnvironment",
    "ty.interpreter": "${workspaceFolder}/.venv/bin/python",
    // Jupyter Notebooks formatter
    "notebook.formatOnSave.enabled": true,
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll": "explicit"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.formatOnSave": true
    },
    // === Terraform / OpenTofu ===
    // HashiCorp extension provides the language server (fmt, validate, completion,
    // hover, go-to-definition). We use OpenTofu (`tofu`) rather than the `terraform`
    // binary, so point the language server at it; fmt-on-save runs `tofu fmt`.
    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[terraform-vars]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "terraform.languageServer.enable": true,
    "terraform.languageServer.path": "/opt/homebrew/bin/tofu",
    "terraform.codelens.referenceCount": false,
    "[jinja-yaml]": {
        "editor.formatOnSave": true
    },
    // === Python Analysis ===
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.analysis.autoFormatStrings": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.exclude": [
        "**/venv/**",
        "**/.venv/**",
        "**/.vscode/**",
        "**/.git/**",
        "**/__pycache__/**",
        "**/.mypy_cache/**",
        "**/.pytest_cache/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/site-packages",
        "**/.*",
    ],
    // === Python Virtual Environment ===
    "python.envFile": "${workspaceFolder}/.env",
    "python.terminal.activateEnvironment": false,
    // Off: the python-envs extension otherwise injects activation into every new
    // terminal, which delays the prompt.
    "python.terminal.activateEnvInCurrentTerminal": false,
    // Off: same reason as above. This is the newer python-envs extension's own hook.
    "python-envs.terminal.autoActivationType": "off",
    // === Python Testing ===
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder}/tests",
    // === Miscellaneous ===
    "update.mode": "manual",
    "extensions.autoUpdate": "on",
    // Off: skips ~50 marketplace version-check requests at every startup.
    // Update extensions manually (Extensions view > ... > Check for Updates).
    "extensions.autoCheckUpdates": false,
    "telemetry.telemetryLevel": "off",
    "redhat.telemetry.enabled": false,
    "window.openFilesInNewWindow": "off",
    "window.confirmBeforeClose": "always",
    // === Files/Housekeeping ===
    "files.autoSave": "onWindowChange",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.ipynb_checkpoints": true,
        "**/*.egg-info": true,
        "**/.DS_Store": true
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.ipynb_checkpoints": true,
        "**/*.egg-info": true,
        "**/.venv": true,
        "**/venv": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.git": true
    },
    // Do not follow symlink trees in search (dotfiles are stow-symlinked).
    "search.followSymlinks": false,
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.ipynb_checkpoints/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.git/objects/**": true,
        // Generated dirs that churn on every dbt run / terraform init.
        "**/target/**": true,
        "**/dbt_packages/**": true,
        "**/.terraform/**": true
    },
    // === Debug/Other ===
    "debug.toolBarLocation": "docked",
    "workbench.colorTheme": "Monokai Night",
    "python.languageServer": "Pylance",
    "editor.inlayHints.enabled": "offUnlessPressed",
    // === dbt & SQL ===
    "files.associations": {
        "*.sql": "jinja-sql"
    },
    "[jinja-sql]": {
        "editor.defaultFormatter": "innoverio.vscode-dbt-power-user",
        "editor.formatOnSave": true
    },
    // No dbt.sqlFmtAdditionalParams line-length override: sqlfmt reads the repo's
    // pyproject [tool.sqlfmt] (line_length = 88); its built-in default is also 88.
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": ".*\\.sql(\\.jinja)?$",
                "notMatch": ".*/dbt/.*",
                "isAsync": true,
                "cmd": "echo 'Running sqlfmt on: ${file}' && $HOME/.local/bin/sqlfmt '${file}'"
            },
            {
                "match": ".*\\.tf$",
                "isAsync": true,
                "cmd": "d=$(dirname '${file}'); cfg=$(cd \"$d\" && git rev-parse --show-toplevel 2>/dev/null); if [ -n \"$cfg\" ] && [ -f \"$cfg/.github/linters/.tflint.hcl\" ]; then /opt/homebrew/bin/tflint --chdir=\"$d\" --config=\"$cfg/.github/linters/.tflint.hcl\"; else /opt/homebrew/bin/tflint --chdir=\"$d\"; fi"
            }
        ]
    },
    "dbt.sqlFmtPath": "${env:HOME}/.local/bin/sqlfmt",
    // === UI & Misc ===
    "workbench.productIconTheme": "fluent-icons",
    "makefile.configureOnOpen": false,
    "git.blame.editorDecoration.enabled": true,
    "diffEditor.ignoreTrimWhitespace": true,
    "dbt.enableNewLineagePanel": true,
    //
    // Copilot and Chat
    //
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": true
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    // === Extensions/Tools ===
    "docker.extension.enableComposeLanguageServer": false,
    "parquet-viewer.format": "csv",
    "chat.mcp.autostart": "newAndOutdated",
    "aws.cloudformation.telemetry.enabled": false,
    "aws.telemetry": false,
    "git.blame.statusBarItem.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    "terminal.external.osxExec": "Ghostty.app",
    // Point dbt at the standard profiles location for any workspace that doesn't override it.
    "terminal.integrated.env.osx": {
        "DBT_PROFILES_DIR": "${env:HOME}/.dbt"
    },
    "claudeCode.preferredLocation": "panel",
    "python.terminal.useEnvFile": false,
    "window.commandCenter": false,
    "terminal.integrated.tabs.enabled": false,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
    "workbench.layoutControl.enabled": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "terminal.integrated.initialHint": false,
    "workbench.activityBar.location": "top",
    "task.allowAutomaticTasks": "off",
    // === Draw.io ===
    // Convention for sharing diagrams in GitHub READMEs: docs/diagrams.md in this repo.
    // Editor appearance follows the active VS Code theme (Monokai Night = dark).
    "hediet.vscode-drawio.appearance": "automatic",
    // "workbench.experimental.modernUI": true,
    // Off: measured on this machine. The DOM renderer drains heavy output about 2x
    // faster than WebGL (650-830ms vs 1650-1900ms per 300k lines of output).
    "terminal.integrated.gpuAcceleration": "off",
    // Off: default on, and its background command scanning can lag the terminal
    // (microsoft/vscode#256746). zsh already covers completion via fzf + zsh-autocomplete.
    "terminal.integrated.suggest.enabled": false,
    // Off: measured about 33ms extra per terminal open, and nothing here uses it.
    "terminal.integrated.shellIntegration.environmentReporting": false,
    // Off: TUI apps (pi, Claude Code) enable this protocol, which makes the terminal
    // swallow Cmd+keys (e.g. Cmd+M minimize) as CSI-u escape sequences sent to the app.
    // Only cost: super+key bindings in TUIs stop working; pi has none by default.
    "terminal.integrated.enableKittyKeyboardProtocol": false,
    "custom-ui-style.reloadWithoutPrompting": true
}
