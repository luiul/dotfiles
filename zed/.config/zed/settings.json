  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Monokai-og"
  },
  "experimental.theme_overrides": {
    "editor.active_line.background": "#008cff28"
  },
  "project_panel": {
    "dock": "right",
    "default_width": 200,
    "entry_spacing": "standard",
    "indent_size": 14,
    "indent_guides": { "show": "always" },
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "sticky_scroll": true,
    "sort_mode": "directories_first",
    "hide_root": false,
    "hide_hidden": false
  },
  "file_scan_exclusions": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.ipynb_checkpoints",
    "**/*.egg-info",
    "..."
  ],
  "confirm_quit": true,
  "cursor_blink": false,
  "current_line_highlight": "all",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_weight": 250,
  "ui_font_size": 14,
  "ui_font_features": { "calt": false, "liga": false, "dlig": false },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_picture": false
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false
  },
  "gutter": {
    "min_line_number_digits": 1
  },
  "tabs": {
    "show_close_button": "hover"
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 14,
  "buffer_font_weight": 250,
  "buffer_line_height": { "custom": 1.3 },
  "buffer_font_features": { "calt": false, "liga": false, "dlig": false },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 14,
    "font_weight": 250,
    "font_features": { "calt": false, "liga": false, "dlig": false },
    "cursor_shape": "bar",
    "blinking": "off"
  }
}
