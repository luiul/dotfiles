zsh_config_dir="$HOME/.zsh_config"

# Orphan guard: interactive shells with no tty and no -c command can never show a
# prompt, but zle spins in a busy loop forever without one (41 such login shells,
# some 8 days old, stole ~6 cores until killed on 2026-10-19). Log the spawner
# and exit. Skipped for tty shells (zero cost on the normal path); shells with
# a -c command (zsh -ic 'cmd', used by tools) pass through.
if [[ -o interactive && ! -t 0 && ! -t 1 ]]; then
	if ! ps -o command= -p $$ | grep -qE -- '(^| )-[a-zA-Z]*c'; then
		mkdir -p "$HOME/.cache"
		{
			print -r -- "$(date '+%Y-%m-%d %H:%M:%S') orphan zsh pid=$$ ppid=$PPID"
			print -r -- "  parent: $(ps -o command= -p $PPID 2>/dev/null)"
			print -r -- "  self: $(ps -o command= -p $$ 2>/dev/null)"
		} >> "$HOME/.cache/zsh-orphan.log"
		exit 1
	fi
fi

if [[ ! -d "$zsh_config_dir" ]]; then
	echo "Config directory not found: $zsh_config_dir" >&2
	return 1
fi

setopt nullglob

zsh_files=("$zsh_config_dir"/*.zsh)

if [[ ${#zsh_files[@]} -eq 0 ]]; then
	echo "No .zsh files found in $zsh_config_dir" >&2
else
	for file in "${zsh_files[@]}"; do
		source "$file" || printf "Error loading: %s\n" "$file" >&2
	done
fi

# Load environment variables from dotfiles/.env (gitignored)
if [[ -f ~/dotfiles/.env ]]; then
	set -a
	source ~/dotfiles/.env
	set +a
else
	echo "Warning: ~/dotfiles/.env not found. Copy example.env to .env and fill in your values." >&2
fi

# From /etc/zshrc (now skipped via GLOBAL_RCS in ~/.zshenv): correct UTF-8 display
setopt COMBINING_CHARS

# Source Znap (installed via setup.sh)
if [[ ! -r ~/repos/znap/znap.zsh ]]; then
	echo "znap not found. Run setup.sh to install." >&2
	return 1
fi
source ~/repos/znap/znap.zsh

# Add Homebrew completions to fpath (must be before compinit / zsh-autocomplete)
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)

# Limit autocomplete menu height to prevent it from taking over the terminal
zstyle ':autocomplete:*' list-lines 16

# zsh-autocomplete, sourced directly instead of `znap source`.
# znap source spawns a child zsh via zpty on EVERY startup just to check the repo
# exists, and that spawn is taxed ~250ms by SentinelOne. The repo is already cloned
# and zcompiled. To update the plugin: git -C ~/repos/marlonrichert/zsh-autocomplete pull
if [[ -r ~/repos/marlonrichert/zsh-autocomplete/zsh-autocomplete.plugin.zsh ]]; then
	source ~/repos/marlonrichert/zsh-autocomplete/zsh-autocomplete.plugin.zsh
fi

# Shell completions generated by CLI tools
znap eval uv 'uv generate-shell-completion zsh'
znap eval uvx 'uvx --generate-shell-completion zsh'
znap eval ruff 'ruff generate-shell-completion zsh'

# Run the following command at the end of the shell config file
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Set up fzf key bindings and fuzzy completion
znap eval fzf 'fzf --zsh'

if command -v wt >/dev/null 2>&1; then znap eval wt 'command wt config shell init zsh'; fi
if command -v coppice >/dev/null 2>&1; then znap eval coppice 'command coppice shell init zsh'; fi

# zoxide must be the last thing initialized
znap eval zoxide 'zoxide init --cmd cd zsh'

alias claude-mem='bun "/Users/luis.aceituno/.claude/plugins/marketplaces/thedotmack/plugin/scripts/worker-service.cjs"'

fpath+=~/.zfunc
# zsh-autocomplete runs compinit itself (async), so no compinit call is needed here.
# Fallback for when the plugin is missing: fast cache mode, no security rescan.
if (( ! $+functions[.autocomplete__compinit] )); then
	autoload -Uz compinit
	compinit -C
fi
export PATH="/Users/luis.aceituno/projects/hellofresh/global-ops/scripts:$PATH"  # global-ops: usql wrapper
