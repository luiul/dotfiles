zsh_config_dir="$HOME/.zsh_config"

# Orphan guard: interactive shells with no tty and no -c command can never show a
# prompt, but zle spins in a busy loop forever without one (41 such login shells,
# some 8 days old, stole ~6 cores until killed on 2026-10-19). Log the spawner
# and exit. Skipped for tty shells (zero cost on the normal path); shells with
# a -c command (zsh -ic 'cmd', used by tools) pass through.
if [[ -o interactive && ! -t 0 && ! -t 1 ]]; then
	if (( ! ${+ZSH_EXECUTION_STRING} )); then
		mkdir -p "$HOME/.cache"
		{
			print -r -- "$(date '+%Y-%m-%d %H:%M:%S') orphan zsh pid=$$ ppid=$PPID"
			print -r -- "  parent: $(ps -o command= -p $PPID 2>/dev/null)"
			print -r -- "  self: $(ps -o command= -p $$ 2>/dev/null)"
		} >> "$HOME/.cache/zsh-orphan.log"
		exit 1
	fi
fi

if [[ ! -d "$zsh_config_dir" ]]; then
	echo "Config directory not found: $zsh_config_dir" >&2
	return 1
fi

setopt nullglob

zsh_files=("$zsh_config_dir"/*.zsh)

if [[ ${#zsh_files[@]} -eq 0 ]]; then
	echo "No .zsh files found in $zsh_config_dir" >&2
else
	for file in "${zsh_files[@]}"; do
		source "$file" || printf "Error loading: %s\n" "$file" >&2
	done
fi

# Load environment variables from dotfiles/.env (gitignored)
if [[ -f ~/dotfiles/.env ]]; then
	set -a
	source ~/dotfiles/.env
	set +a
else
	echo "Warning: ~/dotfiles/.env not found. Copy example.env to .env and fill in your values." >&2
fi

# From /etc/zshrc (now skipped via GLOBAL_RCS in ~/.zshenv): correct UTF-8 display
setopt COMBINING_CHARS

# Source Znap (installed via setup.sh)
if [[ ! -r ~/repos/znap/znap.zsh ]]; then
	echo "znap not found. Run setup.sh to install." >&2
	return 1
fi
source ~/repos/znap/znap.zsh

# Add Homebrew completions to fpath (must be before compinit / zsh-autocomplete)
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)

# Limit autocomplete menu height to prevent it from taking over the terminal
zstyle ':autocomplete:*' list-lines 16

# zsh-autocomplete, sourced directly instead of `znap source`.
# znap source spawns a child zsh via zpty on EVERY startup just to check the repo
# exists, and that spawn is taxed ~250ms by SentinelOne. The repo is already cloned
# and zcompiled. To update the plugin: git -C ~/repos/marlonrichert/zsh-autocomplete pull
# (after a pull, delete stale *.zwc artifacts: find ~/repos/marlonrichert/zsh-autocomplete -name '*.zwc' -delete)
if [[ -r ~/repos/marlonrichert/zsh-autocomplete/zsh-autocomplete.plugin.zsh ]]; then
	source ~/repos/marlonrichert/zsh-autocomplete/zsh-autocomplete.plugin.zsh
fi

# zsh-autocomplete main @ 77706d4 autoloads the zasync clone DIRECTORY as the
# function, so live (per-keystroke) completion silently does nothing
# (https://github.com/marlonrichert/zsh-autocomplete/issues/907, fixed in PR
# https://github.com/marlonrichert/zsh-autocomplete/pull/903, unmerged). Load
# the function by name from the clone first; the async engine's own guard then
# skips its broken autoload. Self-retiring: harmless once the PR merges.
if [[ -r ~/.cache/zsh/zasync/zasync ]]; then
	fpath=(~/.cache/zsh/zasync $fpath)
	(( $+functions[zasync] )) || autoload -Uz +X zasync
fi

# Shell completions generated by CLI tools
znap eval uv 'uv generate-shell-completion zsh'
znap eval uvx 'uvx --generate-shell-completion zsh'
znap eval ruff 'ruff generate-shell-completion zsh'

# Run the following command at the end of the shell config file
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Set up fzf key bindings and fuzzy completion
znap eval fzf 'fzf --zsh'

if command -v wt >/dev/null 2>&1; then znap eval wt 'command wt config shell init zsh'; fi

# wt completion cache. wt's completer shells out to git ~15x per call, and every
# exec on this machine is taxed ~0.3s by SentinelOne, serialized. One uncached
# completion therefore costs 4s+. zsh-autocomplete re-runs the completion on EVERY
# keystroke, each in a throwaway pty fork of the shell, so the result must be
# cached on disk, not in a shell variable. The cache key is cwd plus position plus
# the words already on the line; the current word is deliberately emptied in the
# wt call so the cache holds the FULL candidate list for that position, and zsh
# itself filters it by the typed prefix. Branches created in another window show
# up once the TTL expires. Replaces the completer bound by wt's shell init
# (_wt_lazy_complete) and brew's generated _wt, whose describe logic is copied
# verbatim so rendering (dirs, descriptions) stays identical.
_wt_cached() {
  local -i idx=$(( CURRENT - 1 ))
  local -i ttl=15
  (( $+EPOCHSECONDS )) || zmodload zsh/datetime
  zmodload zsh/stat 2>/dev/null
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/wt/zsh-completion"
  local key="$PWD"$'\x1f'"$idx"$'\x1f'"${(j: :)words[1,idx]}"
  local cache_file="$cache_dir/${key//[^a-zA-Z0-9._-]/_}"
  local now=$EPOCHSECONDS
  local -a out=()
  local mtime
  local -i miss=0
  if [[ -s $cache_file ]] && zstat -A mtime +mtime -- "$cache_file" 2>/dev/null && (( now - mtime < ttl )); then
    out=("${(@f)$(<$cache_file)}")
  else
    miss=1
    out=("${(@f)$( _CLAP_IFS=$'\n' _CLAP_COMPLETE_INDEX=$idx COMPLETE=zsh command wt -- "${(@)words[1,idx]}" "" 2>/dev/null )}")
  fi
  # Drop empty lines. Under zsh-autocomplete a cache miss runs in a throwaway
  # pty worker that gets killed after the completion timeout, so a slow wt
  # call can come back truncated. An empty result must never be cached: it
  # would poison the position for the whole TTL.
  local -a lines=()
  local l
  for l in $out; do
    [[ -n $l ]] && lines+=( "$l" )
  done
  if (( miss )) && (( $#lines )); then
    command mkdir -p "$cache_dir"
    local tmp="$cache_file.tmp.$$"
    print -rl -- $lines > "$tmp"
    command mv -f "$tmp" "$cache_file"
    # Prune entries older than a day. The glob needs nullglob only here.
    () {
      setopt localoptions nullglob
      local -a old=( "$cache_dir"/*(.m+1) )
      (( $#old )) && command rm -f -- $old
    }
  fi
  # Same describe logic as the generated _wt in brew's site-functions.
  local -a dirs=() other=()
  local completion value
  for completion in $lines; do
    value="${completion%%:*}"
    if [[ "$value" == */ ]]; then
      if [[ "$completion" == *:* ]]; then
        dirs+=( "${value%/}:${completion#*:}" )
      else
        dirs+=( "${value%/}" )
      fi
    else
      other+=( "$completion" )
    fi
  done
  [[ -n $dirs ]] && _describe -V 'values' dirs -S '/' -r '/'
  [[ -n $other ]] && _describe -V 'values' other
}
# The zstyles wt's own generated completer would set when first read. It is
# shadowed by _wt_cached, so set them here to keep the single-column list.
zstyle ':completion:*:wt:*' list-max 1
zstyle ':completion:*:*:wt:*' list-grouped false
# zsh-autocomplete kills a slow live completion after this timeout (default 1s).
# wt's fan-out costs 4s+ on a cold cache, so raise the budget: the menu then
# streams in asynchronously once wt finishes instead of never showing at all.
# Cached positions complete instantly and ignore this entirely.
zstyle ':autocomplete:*' timeout 8
# Bind wt to _wt_cached. compinit runs asynchronously under zsh-autocomplete (and
# as a fallback later in this file), so compdef does not exist yet at this point;
# retry from the first prompt where it does, then unhook.
if (( $+functions[compdef] )); then
  compdef _wt_cached wt
else
  _wt_compdef_once() {
    if (( $+functions[compdef] )); then
      compdef _wt_cached wt
      add-zsh-hook -d precmd _wt_compdef_once
      unfunction _wt_compdef_once
    fi
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _wt_compdef_once
fi

# understory polls `wt list` for every known repo (~200 taxed execs per cycle).
# At the 15s default that permanently saturates the machine's serialized exec
# budget and slows every interactive wt command to 20-60s (see _wt_cached note
# above). 60s keeps the dashboard fresh enough while cutting that load 4x.
alias understory='understory --interval 60'

if command -v coppice >/dev/null 2>&1; then znap eval coppice 'command coppice shell init zsh'; fi

# zoxide must be the last thing initialized
znap eval zoxide 'zoxide init --cmd cd zsh'


fpath+=~/.zfunc
# zsh-autocomplete runs compinit itself (async), so no compinit call is needed here.
# Fallback for when the plugin is missing: fast cache mode, no security rescan.
if (( ! $+functions[.autocomplete__compinit] )); then
	autoload -Uz compinit
	compinit -C
fi
export PATH="/Users/luis.aceituno/projects/hellofresh/global-ops/scripts:$PATH"  # global-ops: usql wrapper

# Cache Mole completion output. The resolved path and mtime invalidate Znap's
# command header after an executable update, without spawning another process.
if (( $+commands[mole] )); then
  () {
    local executable=${commands[mole]:A}
    local -a mtime=()
    zmodload zsh/stat
    zstat -A mtime +mtime -- "$executable" 2>/dev/null
    local -i had_compdef=$+functions[compdef]
    # Mole's output calls compdef directly. Skip that call if compinit is not
    # ready, then bind both names below when the first prompt can do so.
    (( had_compdef )) || compdef() { :; }
    {
      znap eval mole "command ${(q)executable} completion zsh 2>/dev/null # ${mtime[1]:-0}"
    } always {
      (( had_compdef )) || unfunction compdef
    }
  }
  if (( $+functions[_mole] )); then
    if (( $+functions[compdef] )); then
      compdef _mole mole mo
    else
      _mole_compdef_once() {
        if (( $+functions[compdef] )); then
          compdef _mole mole mo
          add-zsh-hook -d precmd _mole_compdef_once
          unfunction _mole_compdef_once
        fi
      }
      autoload -Uz add-zsh-hook
      add-zsh-hook precmd _mole_compdef_once
    fi
  fi
fi
